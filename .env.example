# PixelCut Local Configuration Example
# (Optional environment variable overrides)

# Server Configuration
PIXELCUT_SERVER_HOST=127.0.0.1
PIXELCUT_SERVER_PORT=8765
PIXELCUT_LAN_MODE=false

# Processing Safety Limits
PIXELCUT_MAX_UPLOAD_MB=25
PIXELCUT_MAX_MEGAPIXELS=40
PIXELCUT_MAX_BATCH_COUNT=100
PIXELCUT_MAX_CONCURRENT_JOBS=1

# Storage Retention (hours)
PIXELCUT_TEMP_RETENTION_HOURS=12

# Model Configuration
# Default model name (e.g. u2net, u2netp, isnet-general-use, bria-rmbg)
PIXELCUT_DEFAULT_MODEL=u2netp
